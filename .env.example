# ───────────────────── Jigar Matka House frontend (jigar-pot-shop, Next.js) ─────────────────────
# Copy to .env.local for local development. Placeholders only.

# Backend (jigar-pot-shop-backend) base URL, e.g. https://api.example.com. Not a secret.
# Used by server-side fetches and by proxy.ts, which forwards the browser's same-origin /api/v1 and
# /media requests there. NEXT_PUBLIC_ values are fixed at build time: rebuild after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional private-network address that takes precedence on the server (e.g. http://api:4000).
# API_INTERNAL_URL=

# Public origin of this site — used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with the API (REVALIDATE_SECRET there). Lets the API refresh cached pages after edits.
REVALIDATE_SECRET=change-me-shared-revalidate-secret

# Must match INTERNAL_API_TOKEN in the API. Server-side catalogue requests skip per-IP limits, and
# forwarded browser requests carry the visitor's address so the API limits each visitor separately
# (required when web and API are deployed separately). Server-only — never prefix with NEXT_PUBLIC_.
# INTERNAL_API_TOKEN=
