# ─────────────────────────── Jigar Matka House web (Next.js) ───────────────────────────
# Copy to .env.local for local development. Placeholders only.

# Where the Next.js server reaches the API (server-side fetches and dev rewrites).
# Also read at build time for the rewrite rules.
API_INTERNAL_URL=http://localhost:4000

# Public origin of this site — used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with the API (REVALIDATE_SECRET there). Lets the API refresh cached pages after edits.
REVALIDATE_SECRET=change-me-shared-revalidate-secret

# Optional: lets server-side catalogue requests bypass per-IP API rate limits.
# Must match INTERNAL_API_TOKEN in the API. Server-only — never prefix with NEXT_PUBLIC_.
# INTERNAL_API_TOKEN=
