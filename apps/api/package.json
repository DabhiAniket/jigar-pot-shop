{
  "name": "@jmh/api",
  "version": "1.0.0",
  "private": true,
  "description": "Jigar Matka House REST API (Express) and background worker.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false --env-file-if-exists=.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "media:cleanup": "tsx --env-file-if-exists=.env scripts/cleanup-media.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@jmh/shared": "*",
    "argon2": "^0.45.1",
    "bullmq": "^6.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.11.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server-core": "^11.3.0",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
