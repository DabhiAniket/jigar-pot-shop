{
  "name": "jigar-pot-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Jigar Matka House storefront and admin panel (Next.js App Router).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "NODE_ENV=production next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "^6.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
